# --- shared by every sapphire-turtle repository (sapphire-framework/ci/templates/.gitignore) ---

# Generated by Cargo
debug
target

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# Agent and tooling scratch: Claude Code settings and worktrees, the
# subagent-driven-development ledger, local git worktrees
.claude
.superpowers/
.worktrees/

# macOS Finder metadata
.DS_Store

# --- repository specific ---

# Local test rigs — bot tokens, API keys, model paths, and the
# runtime artifacts produced when these configs are used as the
# agent's workspace_dir all live here. Throwaway by design, never
# tracked.
test-configs/
